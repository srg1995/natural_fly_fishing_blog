{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(bun run check)",
			"Bash(bun run lint)",
			"Bash(bun run format)",
			"Bash(bun run test)",
			"Bash(bunx vitest run:*)",
			"Bash(bunx prettier:*)",
			"Bash(bunx eslint:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git branch:*)",
			"Bash(git fetch:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr list:*)",
			"Bash(gh pr diff:*)",
			"Bash(gh pr checks:*)"
		],
		"deny": [
			"Read(./.env)",
			"Bash(git push origin main)",
			"Bash(git push origin main:*)",
			"Bash(git push --force:*)",
			"Bash(gh pr merge:*)"
		]
	}
}
